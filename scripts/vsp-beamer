#!/usr/bin/env bash
set -euo pipefail

[[ "$(uname -s)" == Linux ]] || {
  printf 'vsp-beamer: only Linux is supported\n' >&2
  exit 1
}

PROGRAM="vsp-beamer"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
DEFAULT_SOURCE="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd || true)"

usage() {
  cat <<'EOF'
Usage: vsp-beamer <command> [options]

Commands:
  install [--from PATH]       Install or replace the user-level runtime
  update [--from PATH]        Update from a local clone or the configured remote
  status                      Show installed version and paths
  verify                      Verify Kpathsea lookup and compile outside the repository
  rollback                    Switch back to the previous installed release
  uninstall                   Remove the user-level runtime and command link
  package [--output FILE]     Build a TDS archive from a source checkout
EOF
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

texmf_home() {
  if [[ -n "${TEXMFHOME:-}" ]]; then
    printf '%s\n' "$TEXMFHOME"
  else
    kpsewhich -var-value=TEXMFHOME
  fi
}

source_version() {
  local root="$1"
  [[ -f "$root/VERSION" ]] || die "VERSION not found under source: $root"
  tr -d '[:space:]' < "$root/VERSION"
}

validate_source() {
  local root="$1"
  [[ -x "$root/scripts/vsp-beamer" ]] || die "invalid source checkout: $root"
  [[ -f "$root/themes/beamerthemeVSP.sty" ]] || die "shared theme missing under source: $root"
  command -v fc-match >/dev/null 2>&1 || die "fontconfig is required to locate Noto CJK system fonts"
  for family in "Noto Serif CJK SC" "Noto Sans CJK SC" "Noto Sans Mono CJK SC"; do
    fc-match --format='%{family}\n' "$family" | grep -Fq "$family" || \
      die "$family is not installed (install fonts-noto-cjk on Debian/Ubuntu)"
  done
}

source_url() {
  local root="$1"
  git -C "$root" config --get remote.origin.url 2>/dev/null || true
}

stage_release() {
  local root="$1" release="$2" version="$3" url="$4"
  local asset
  mkdir -p "$release/tex" "$release/bin" "$release/doc"
  cp "$root"/themes/*.sty "$release/tex/"
  while IFS= read -r -d '' asset; do
    cp "$asset" "$release/tex/"
  done < <(find "$root/shared-assets" -type f -name '*.png' -print0)
  cp "$root/scripts/vsp-beamer" "$release/bin/vsp-beamer"
  chmod 755 "$release/bin/vsp-beamer"
  cp "$root/README.md" "$root/CHANGELOG.md" "$root/LICENSE" "$root/THIRD_PARTY_ASSETS.md" "$root/VERSION" "$release/doc/"
  printf '%s\n' "$version" > "$release/tex/vsp-beamer.version"
  printf '%s\n' "$url" > "$release/source-url"
}

ensure_public_links() {
  local home="$1" state="$2" bindir="$3"
  local tex_link="$home/tex/latex/vsp-beamer"
  local font_link="$home/fonts/opentype/vsp-beamer"
  local bin_link="$bindir/vsp-beamer"
  local pair link target
  mkdir -p "$(dirname "$tex_link")" "$bindir"
  if [[ -L "$font_link" && "$(readlink "$font_link")" == "$state/current/fonts" ]]; then
    rm -f "$font_link"
  fi
  for pair in \
    "$tex_link|$state/current/tex" \
    "$bin_link|$state/current/bin/vsp-beamer"; do
    link="${pair%%|*}"
    target="${pair#*|}"
    if [[ -e "$link" && ! -L "$link" ]]; then
      die "refusing to replace unmanaged path: $link"
    fi
    ln -sfn "$target" "$link"
  done
}

switch_release() {
  local state="$1" release="$2"
  local old="" tmp="$state/.current.$$"
  if [[ -L "$state/current" ]]; then
    old="$(readlink -f "$state/current")"
  fi
  ln -s "$release" "$tmp"
  mv -Tf "$tmp" "$state/current"
  if [[ -n "$old" && "$old" != "$release" ]]; then
    ln -sfn "$old" "$state/previous"
  fi
}

install_from() {
  local root="$1" home state bindir version url release
  root="$(cd "$root" && pwd)"
  validate_source "$root"
  version="$(source_version "$root")"
  url="$(source_url "$root")"
  home="$(texmf_home)"
  state="$home/vsp-beamer"
  bindir="${VSP_BINDIR:-${HOME}/.local/bin}"
  release="$state/releases/${version}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$state/releases"
  stage_release "$root" "$release" "$version" "$url"
  ensure_public_links "$home" "$state" "$bindir"
  switch_release "$state" "$release"
  if ! verify_install true; then
    if [[ -L "$state/previous" ]]; then
      switch_release "$state" "$(readlink -f "$state/previous")"
    else
      rm -f "$state/current"
    fi
    die "verification failed; the previous release was restored"
  fi
  printf 'Installed VSP-Beamer v%s\n' "$version"
  printf '  TEXMFHOME: %s\n' "$home"
  printf '  command:   %s/vsp-beamer\n' "$bindir"
  if [[ ":${PATH}:" != *":${bindir}:"* ]]; then
    printf '  note: add %s to PATH to run vsp-beamer directly\n' "$bindir"
  fi
}

current_release() {
  local state="$(texmf_home)/vsp-beamer"
  [[ -L "$state/current" ]] || return 1
  readlink -f "$state/current"
}

installed_version() {
  local release
  release="$(current_release)" || return 1
  [[ -f "$release/tex/vsp-beamer.version" ]] || return 1
  tr -d '[:space:]' < "$release/tex/vsp-beamer.version"
}

verify_install() {
  local compile="${1:-true}" home release tmp log file
  home="$(texmf_home)"
  release="$(current_release)" || { printf '%s: not installed\n' "$PROGRAM" >&2; return 1; }
  for file in \
    beamerthemeVSP.sty beamerthemetutorial-red-shtu.sty beamerthemetutorial-purple.sty \
    beamerthemetutorial-nailong.sty beamerthemereport-red.sty \
    beamerthemereport-nailong.sty shanghaitech-master.png \
    ShanghaiTech_Logo_RGBA.png nailong-bg.png; do
    local found
    found="$(TEXMFHOME="$home" kpsewhich "$file" || true)"
    [[ -n "$found" && "$(readlink -f "$found")" == "$release"/* ]] || {
      printf '%s: Kpathsea lookup failed for %s\n' "$PROGRAM" "$file" >&2
      return 1
    }
  done
  [[ "$compile" == true ]] || return 0
  command -v latexmk >/dev/null 2>&1 || die "latexmk is required for verification"
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp:-}"' RETURN
  cat > "$tmp/verify.tex" <<'EOF'
\documentclass[aspectratio=169,10pt]{beamer}
\usepackage[UTF8,fontset=none]{ctex}
\usetheme{tutorial-red-shtu}
\title{VSP-Beamer Installation Check}
\VSPsetspeaker{VSP-Beamer}{仓库外用户级安装验证}
\begin{document}
\VSPtitleframe
\section{验证}
\begin{frame}{Runtime assets}
  中文字体、主题、背景与 Logo 均由 TEXMFHOME 加载。
\end{frame}
\VSPendframe{Installation verified}
\end{document}
EOF
  log="$tmp/latexmk.log"
  if ! (cd "$tmp" && TEXMFHOME="$home" latexmk -xelatex -interaction=nonstopmode \
      -halt-on-error -file-line-error verify.tex >"$log" 2>&1); then
    sed -n '1,220p' "$log" >&2
    return 1
  fi
  [[ -s "$tmp/verify.pdf" ]] || return 1
  printf 'VSP-Beamer v%s installation verified.\n' "$(installed_version)"
}

show_status() {
  local home state release version previous="none"
  home="$(texmf_home)"
  state="$home/vsp-beamer"
  if ! release="$(current_release)"; then
    printf 'VSP-Beamer is not installed in %s.\n' "$home"
    return 1
  fi
  version="$(installed_version)"
  [[ -L "$state/previous" ]] && previous="$(readlink -f "$state/previous")"
  printf 'VSP-Beamer v%s\n' "$version"
  printf '  TEXMFHOME: %s\n' "$home"
  printf '  release:   %s\n' "$release"
  printf '  previous:  %s\n' "$previous"
  printf '  theme:     %s\n' "$(TEXMFHOME="$home" kpsewhich beamerthemeVSP.sty || true)"
}

rollback_install() {
  local home state current previous
  home="$(texmf_home)"
  state="$home/vsp-beamer"
  [[ -L "$state/current" ]] || die "VSP-Beamer is not installed"
  [[ -L "$state/previous" ]] || die "no previous release is available"
  current="$(readlink -f "$state/current")"
  previous="$(readlink -f "$state/previous")"
  [[ -d "$previous" ]] || die "previous release no longer exists: $previous"
  ln -sfn "$current" "$state/previous"
  switch_release "$state" "$previous"
  verify_install true || die "rollback verification failed"
  printf 'Rolled back to VSP-Beamer v%s.\n' "$(installed_version)"
}

uninstall_runtime() {
  local home state bindir
  home="$(texmf_home)"
  state="$home/vsp-beamer"
  bindir="${VSP_BINDIR:-${HOME}/.local/bin}"
  [[ -L "$home/tex/latex/vsp-beamer" ]] && rm -f "$home/tex/latex/vsp-beamer"
  [[ -L "$home/fonts/opentype/vsp-beamer" ]] && rm -f "$home/fonts/opentype/vsp-beamer"
  if [[ -L "$bindir/vsp-beamer" && "$(readlink -f "$bindir/vsp-beamer")" == "$state"/* ]]; then
    rm -f "$bindir/vsp-beamer"
  fi
  rm -rf "$state"
  printf 'Removed VSP-Beamer from %s.\n' "$home"
}

update_runtime() {
  local from="" home release url tmp
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) [[ $# -ge 2 ]] || die "--from requires a path"; from="$2"; shift 2 ;;
      *) die "unknown update option: $1" ;;
    esac
  done
  if [[ -n "$from" ]]; then
    install_from "$from"
    return
  fi
  home="$(texmf_home)"
  release="$(current_release)" || die "not installed; run make install from a checkout first"
  url="$(<"$release/source-url")"
  [[ -n "$url" ]] || die "no source remote is configured; use vsp-beamer update --from /path/to/clone"
  command -v git >/dev/null 2>&1 || die "git is required for remote updates"
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp:-}"' RETURN
  timeout "${VSP_UPDATE_TIMEOUT:-30}" git clone --depth=1 "$url" "$tmp/source"
  install_from "$tmp/source"
}

package_tds() {
  local root="$1" output="$2" version stage asset
  root="$(cd "$root" && pwd)"
  validate_source "$root"
  version="$(source_version "$root")"
  [[ -n "$output" ]] || output="$root/build/vsp-beamer-${version}.tds.tar.gz"
  mkdir -p "$(dirname "$output")"
  stage="$(mktemp -d)"
  trap 'rm -rf "${stage:-}"' RETURN
  mkdir -p "$stage/tex/latex/vsp-beamer" \
    "$stage/scripts/vsp-beamer" "$stage/doc/latex/vsp-beamer"
  cp "$root"/themes/*.sty "$stage/tex/latex/vsp-beamer/"
  while IFS= read -r -d '' asset; do
    cp "$asset" "$stage/tex/latex/vsp-beamer/"
  done < <(find "$root/shared-assets" -type f -name '*.png' -print0)
  cp "$root/scripts/vsp-beamer" "$stage/scripts/vsp-beamer/"
  cp "$root/README.md" "$root/CHANGELOG.md" "$root/LICENSE" "$root/THIRD_PARTY_ASSETS.md" "$root/VERSION" "$stage/doc/latex/vsp-beamer/"
  printf '%s\n' "$version" > "$stage/tex/latex/vsp-beamer/vsp-beamer.version"
  tar -C "$stage" -czf "$output" .
  printf '%s\n' "$output"
}

command="${1:-}"
[[ -n "$command" ]] || { usage; exit 2; }
shift
case "$command" in
  install)
    source="$DEFAULT_SOURCE"
    if [[ "${1:-}" == --from ]]; then [[ $# -ge 2 ]] || die "--from requires a path"; source="$2"; shift 2; fi
    [[ $# -eq 0 ]] || die "unknown install option: $1"
    install_from "$source"
    ;;
  update) update_runtime "$@" ;;
  status) [[ $# -eq 0 ]] || die "status takes no options"; show_status ;;
  verify) [[ $# -eq 0 ]] || die "verify takes no options"; verify_install true ;;
  rollback) [[ $# -eq 0 ]] || die "rollback takes no options"; rollback_install ;;
  uninstall) [[ $# -eq 0 ]] || die "uninstall takes no options"; uninstall_runtime ;;
  package)
    output=""
    if [[ "${1:-}" == --output ]]; then [[ $# -ge 2 ]] || die "--output requires a file"; output="$2"; shift 2; fi
    [[ $# -eq 0 ]] || die "unknown package option: $1"
    package_tds "$DEFAULT_SOURCE" "$output"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
