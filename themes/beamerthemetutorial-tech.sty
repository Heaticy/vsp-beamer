\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemetutorial-tech}[2026/11/27 v0.3.1 VSP tutorial tech]

% Tech tutorial style: the SI100B circuit look (vsplab.cn/courses/si100b/slides)
% as a VSP layer. Near-black blue canvas (dark) or light grey (light), a title
% band with PCB traces and the shared vector school logo, blue-violet accents,
% Latin Modern / Noto Sans CJK SC typography, cards for figures and callouts.
% Circuit artwork is pre-rendered per variant in shared-assets/tech/. The
% entries tutorial-tech-dark and tutorial-tech-light set \VSPtechvariant before
% loading this layer.
\providecommand{\VSPtechvariant}{dark}
\RequirePackage[red,tutorial,sectionpages]{beamerthemeVSP}
\tcbuselibrary{skins}
\usetikzlibrary{fadings,calc}

