\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemepresentation}[2026/11/27 v0.3.1 VSP ShanghaiTech presentation]

% ShanghaiTech presentation style: the shared VSP implementation supplies fonts,
% speaker and footline setters, code and float helpers; this layer switches the
% palette to ShanghaiTech black-red with a gold accent (overridable via
% \providecolor in palette entries) and replaces every visible template with an
% understated editorial layout: clean gradient cover with campus skyline and
% crest, agenda section pages, crisp top-accented frame titles with breadcrumb
% and crest, minimal progress footline, and soft-header rounded card callouts.
% It also provides stat, mark, chip, step and meter components.
\RequirePackage[red,tutorial,sectionpages]{beamerthemeVSP}
\tcbuselibrary{skins}

% ---- Palette ---------------------------------------------------------------
% SHTURed is the crest color of the official vector emblem (#A40006).
\providecolor{SHTURed}{HTML}{A40006}
\providecolor{SHTURedSoft}{HTML}{F5E6E7}
\providecolor{SHTUDeep}{HTML}{2A0305}
\providecolor{SHTUBright}{HTML}{C4161F}
\providecolor{SHTUGold}{HTML}{C59B3E}
\providecolor{SHTUGoldLight}{HTML}{E9C46A}
\colorlet{VSPPrimary}{SHTURed}
\colorlet{VSPAccent}{SHTURed}
\colorlet{VSPSoft}{SHTURedSoft}
\colorlet{VSPCodeBackground}{SHTURedSoft!45!white}
\definecolor{VSPCalloutBlue}{HTML}{4A6FA5}
\definecolor{VSPCalloutRed}{HTML}{B03A48}
\definecolor{VSPCalloutGreen}{HTML}{4F8242}
\definecolor{VSPCalloutPurple}{HTML}{6E3B7A}
\definecolor{VSPCalloutYellow}{HTML}{B8891F}
\colorlet{VSPCalloutDefault}{SHTURed}

\mode<presentation>
\renewcommand{\familydefault}{\sfdefault}
\setbeamercolor{structure}{fg=SHTURed}
\setbeamercolor{alerted text}{fg=SHTURed}
\setbeamercolor{frametitle}{fg=SHTURed,bg=white}
\setbeamerfont{normal text}{family=\sffamily}
\setbeamerfont{title}{family=\sffamily,series=\bfseries,size=\fontsize{22}{28.5}\selectfont}
\setbeamerfont{subtitle}{family=\sffamily,series=\mdseries,size=\fontsize{11}{15}\selectfont}
\setbeamerfont{section title}{family=\sffamily,series=\bfseries,size=\fontsize{21.5}{28}\selectfont}
\setbeamerfont{end title}{family=\sffamily,series=\bfseries,size=\fontsize{28}{34}\selectfont}
\AtBeginDocument{\sffamily}

\newcommand{\vsp@two}[1]{\ifnum#1<10 0\fi\number#1}

% White ShanghaiTech artwork cut from the white master background: the
% campus skyline (bottom left) and the motto calligraphy (bottom right).
\newcommand{\vsp@skyline}[1]{\includegraphics[trim=0 6 1010 605,clip,#1]{\VSPasset{shanghaitech-master-white.pdf}}}
\newcommand{\vsp@motto}[1]{\includegraphics[trim=1130 6 0 748,clip,#1]{\VSPasset{shanghaitech-master-white.pdf}}}

% Number of sections, counted from the previous run's .toc; it drives the
% footline indicator and stays zero on the first pass.
\newcount\vsp@sectotal
\AtBeginDocument{%
  \begingroup
    \def\beamer@endinputifotherversion#1{}%
    \def\beamer@sectionintoc#1#2#3#4#5{\global\advance\vsp@sectotal\@ne}%
    \def\beamer@subsectionintoc#1#2#3#4#5#6{}%
    \def\beamer@subsubsectionintoc#1#2#3#4#5#6#7{}%
    \makeatletter\@input{\jobname.toc}%
  \endgroup}

% Dark field shared by cover, section and end frames: a clean tonal gradient.
\newcommand{\vsp@showfield}{%
  \shade[left color=SHTUDeep,right color=SHTUBright,shading angle=55]
    (current page.south west) rectangle (current page.north east);}

% ---- Canvas, frame title and footline ---------------------------------------
\setbeamertemplate{background}{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \clip (0,0) rectangle (\paperwidth,\paperheight);
    \node[opacity=.028,anchor=south east,inner sep=0pt] at (\paperwidth+.55cm,-1.05cm)
      {\includegraphics[height=5.4cm]{\VSPasset{ShanghaiTech_Logo.pdf}}};
  \end{tikzpicture}}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.04cm,dp=0.22cm]{frametitle}\end{beamercolorbox}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[SHTURed] (current page.north west)
      rectangle ([yshift=-2pt]current page.north east);
    \ifnum\c@section>0
      \node[anchor=base west,inner sep=0pt,text=SHTUGold,
        font=\sffamily\bfseries\fontsize{6}{6.8}\selectfont]
        at ([xshift=.72cm,yshift=-.48cm]current page.north west)
        {\vsp@two{\c@section}\hspace{.45em}\textcolor{VSPMuted}{\mdseries\insertsection}};
    \fi
    \node[anchor=base west,inner sep=0pt,text=SHTURed,font=\usebeamerfont{frametitle}]
      at ([xshift=.72cm,yshift=-.99cm]current page.north west) {\insertframetitle};
    \node[anchor=north east,inner sep=0pt] at ([xshift=-.72cm,yshift=-.27cm]current page.north east)
      {\includegraphics[height=.80cm]{\VSPasset{ShanghaiTech_Logo.pdf}}};
    \draw[SHTURed!28!white,line width=.5pt]
      ([xshift=.72cm,yshift=-1.19cm]current page.north west)
      -- ([xshift=-.72cm,yshift=-1.19cm]current page.north east);
  \end{tikzpicture}%
}

\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=.40cm,dp=.16cm]{footline}\end{beamercolorbox}%
  \begin{tikzpicture}[remember picture,overlay]
    \pgfmathsetmacro{\vsp@progress}{min(1,\insertframenumber/max(1,\inserttotalframenumber))}
    \fill[VSPMuted!16!white] (current page.south west) rectangle ([yshift=1.2pt]current page.south east);
    \fill[SHTURed] (current page.south west)
      rectangle ([xshift=\vsp@progress\paperwidth,yshift=1.2pt]current page.south west);
    \node[anchor=base west,inner sep=0pt,text=VSPMuted,font=\sffamily\fontsize{5.8}{7}\selectfont]
      at ([xshift=.72cm,yshift=.21cm]current page.south west) {\vsp@footleft};
    \ifnum\vsp@sectotal>0
      \edef\vsp@n{\the\vsp@sectotal}%
      \foreach \vsp@i in {1,...,\vsp@n} {
        \pgfmathsetmacro{\vsp@dx}{(\vsp@i-(\vsp@n+1)/2)*0.24}
        \ifnum\vsp@i<\c@section
          \fill[SHTURed!55!white] ([xshift=\vsp@dx cm,yshift=.26cm]current page.south) circle (1.15pt);
        \else\ifnum\vsp@i=\c@section
          \fill[SHTURed,rounded corners=1.2pt]
            ([xshift=\vsp@dx cm-3pt,yshift=.26cm-1.2pt]current page.south)
            rectangle ([xshift=\vsp@dx cm+3pt,yshift=.26cm+1.2pt]current page.south);
        \else
          \fill[VSPMuted!35] ([xshift=\vsp@dx cm,yshift=.26cm]current page.south) circle (1.15pt);
        \fi\fi}
    \fi
    \node[anchor=base east,inner sep=0pt,text=VSPMuted,font=\sffamily\fontsize{5.8}{7}\selectfont]
      at ([xshift=-.72cm,yshift=.21cm]current page.south east)
      {\vsp@footright\hspace{.8em}{\color{SHTURed}\bfseries\insertframenumber}\,/\,\inserttotalframenumber};
  \end{tikzpicture}%
}

% ---- Cover -------------------------------------------------------------------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \vsp@showfield
    \node[opacity=.18,inner sep=0pt,anchor=south east] at ([xshift=-.55cm]current page.south east)
      {\vsp@skyline{height=2.6cm}};
    \node[anchor=north west,inner sep=0pt] at ([xshift=.95cm,yshift=-.65cm]current page.north west)
      {\includegraphics[height=.96cm]{\VSPasset{ShanghaiTech_Name_White.pdf}}};
    \node[anchor=north east,inner sep=0pt,text=white!76!SHTUDeep,font=\sffamily\fontsize{8.5}{11}\selectfont]
      at ([xshift=-.95cm,yshift=-.92cm]current page.north east) {\insertdate};
    \node[anchor=north west,text width=.74\paperwidth,align=left,inner sep=0pt]
      at ([xshift=.95cm,yshift=-2.80cm]current page.north west)
      {{\usebeamerfont{title}\color{white}\vsp@displaywrap\inserttitle\par}\vspace{8pt}%
       {\usebeamerfont{subtitle}\color{white!80!SHTUDeep}\vsp@displaywrap\insertsubtitle\par}};
    \node[anchor=south west,inner sep=0pt,align=left] (vsp@sp)
      at ([xshift=.95cm,yshift=.92cm]current page.south west)
      {{\sffamily\bfseries\fontsize{6.6}{8}\selectfont\color{white!68!SHTUDeep}\vsp@speakerlabel}\\[2.5pt]
       {\sffamily\bfseries\fontsize{10.5}{13}\selectfont\color{white}\vsp@speakername}\\[2pt]
       {\sffamily\fontsize{8}{11}\selectfont\color{white!76!SHTUDeep}\vsp@speakerdetail}};
  \end{tikzpicture}%
}

% ---- Section pages -----------------------------------------------------------
% The right-hand list is rebuilt from the .toc and highlights the current
% section, so every section page doubles as an agenda.
\newcommand{\vsp@showtoc}{%
  \begingroup
    \def\beamer@endinputifotherversion##1{}%
    \def\beamer@sectionintoc##1##2##3##4##5{%
      \ifnum##1=\c@section
        {\color{white}\bfseries\vsp@two{##1}\hspace{.75em}##2\par}%
      \else
        {\color{white!45!SHTUDeep}\vsp@two{##1}\hspace{.75em}##2\par}%
      \fi\vspace{7pt}}%
    \def\beamer@subsectionintoc##1##2##3##4##5##6{}%
    \def\beamer@subsubsectionintoc##1##2##3##4##5##6##7{}%
    \makeatletter\@input{\jobname.toc}%
  \endgroup}

\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \vsp@showfield
    \node[opacity=.045,inner sep=0pt,anchor=east] at ([xshift=1.8cm,yshift=.4cm]current page.east)
      {\includegraphics[height=1.24\paperheight]{\VSPasset{ShanghaiTech_Logo_White.pdf}}};
    \node[anchor=base west,inner sep=0pt,font=\sffamily\bfseries\fontsize{54}{54}\selectfont,
      text=white,opacity=.22]
      at ([xshift=1.02cm,yshift=.52cm]current page.west) {\vsp@two{\c@section}};
    \node[anchor=north west,inner sep=0pt,text=white,align=left,text width=.52\paperwidth,
      font=\usebeamerfont{section title}]
      at ([xshift=1.08cm,yshift=.05cm]current page.west) {\vsp@displaywrap\insertsection};
    \node[anchor=west,inner sep=0pt,align=left,text width=.31\paperwidth,
      font=\sffamily\fontsize{9.2}{12}\selectfont] (vsp@toc)
      at ([xshift=.635\paperwidth]current page.west) {\vsp@showtoc};
  \end{tikzpicture}%
}

\renewcommand{\VSPsectionframe}[2]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \vsp@showfield
      \node[text=white,align=center,text width=.86\paperwidth,
        font=\usebeamerfont{end title}] at ([yshift=.30cm]current page.center)
        {\vsp@displaywrap #1\\[9pt]{\usebeamerfont{section subtitle}\color{white!80!SHTUDeep}#2}};
    \end{tikzpicture}
  \end{frame}}

% ---- End frame ---------------------------------------------------------------
\renewcommand{\VSPendframe}[1]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \vsp@showfield
      \node[opacity=.16,inner sep=0pt,anchor=south] at (current page.south)
        {\vsp@skyline{height=2.7cm}};
      \node[text=white,inner sep=0pt,font=\usebeamerfont{end title}]
        at ([yshift=1.25cm]current page.center) {Thank You};
      \node[text=white!82!SHTUDeep,inner sep=0pt,align=center,text width=.80\paperwidth,
        font=\sffamily\fontsize{10}{14}\selectfont] at ([yshift=.42cm]current page.center) {#1};
      \node[anchor=north west,inner sep=0pt] at ([xshift=.95cm,yshift=-.65cm]current page.north west)
        {\includegraphics[height=.96cm]{\VSPasset{ShanghaiTech_Name_White.pdf}}};
      \node[anchor=north east,inner sep=0pt] at ([xshift=-.95cm,yshift=-.82cm]current page.north east)
        {\vsp@motto{height=.60cm}};
    \end{tikzpicture}
  \end{frame}}

% ---- Lists -------------------------------------------------------------------
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-.62ex]{\fill[SHTURed] (0,0) circle (1.6pt);}}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-.62ex]{\fill[VSPMuted] (0,0) circle (1.1pt);}}
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=(n.base)]\node[circle,fill=SHTURed,text=white,font=\sffamily\scriptsize\bfseries,
  minimum size=1.45em,inner sep=0pt] (n) {\insertenumlabel};}

% ---- Callouts and blocks: rounded card with a soft-tinted header band --------
\tcbset{vsp@callout/.append style={fontupper=\sffamily\vspbodyfont}}
\renewtcolorbox{vspcallout}[2][SHTURed]{vsp@callout=#1,title={#2}}
\setbeamertemplate{block begin}{\begin{tcolorbox}[vsp@callout=SHTURed,title={\insertblocktitle}]}
\setbeamertemplate{block end}{\end{tcolorbox}}
\setbeamertemplate{block alerted begin}{\begin{tcolorbox}[vsp@callout=VSPCalloutRed,title={\insertblocktitle}]}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}
\setbeamertemplate{block example begin}{\begin{tcolorbox}[vsp@callout=SHTUGold,title={\insertblocktitle}]}
\setbeamertemplate{block example end}{\end{tcolorbox}}

% ---- Components --------------------------------------------------------------
% \VSPstat[color]{figure}{label}{note}: headline number on a subtle rounded card.
\newcommand{\VSPstat}[4][SHTURed]{%
  \par\noindent
  \begin{tcolorbox}[enhanced,colback=#1!4!white,colframe=#1!22!white,
      boxrule=0.5pt,arc=1.5mm,outer arc=1.5mm,boxsep=0pt,
      left=3mm,right=2.5mm,top=2.2mm,bottom=2.2mm,before skip=2pt,after skip=4pt]
    {\sffamily\bfseries\fontsize{19}{21}\selectfont\color{#1}#2\par}\vskip 2.5pt
    {\sffamily\bfseries\fontsize{7.6}{9.4}\selectfont\color{VSPText}#3\par}%
    \ifstrempty{#4}{}{{\sffamily\fontsize{6}{7.8}\selectfont\color{VSPMuted}#4\par}}%
  \end{tcolorbox}}

% \VSPmark{text}: restrained soft-tinted inline highlight.
\newcommand{\VSPmark}[1]{%
  \tikz[baseline=(m.base)]\node[fill=SHTURed!10!white,text=SHTURed,rounded corners=1.8pt,
    inner xsep=2.6pt,inner ysep=1pt,outer sep=0pt,font=\bfseries] (m) {#1};}

% \VSPchip[color]{text}: pill label.
\newcommand{\VSPchip}[2][SHTURed]{%
  \tikz[baseline=(c.base)]\node[fill=#1!8!white,draw=#1!25!white,line width=.4pt,
    text=#1,rounded corners=3pt,
    inner xsep=4.5pt,inner ysep=1.7pt,outer sep=0pt,
    font=\sffamily\bfseries\fontsize{6.2}{7.2}\selectfont] (c) {#2};}

% \VSPsteps{a,b,c}: clean numbered step strip with light cards and thin arrows.
\newcommand{\VSPsteps}[1]{%
  \par\noindent
  \begin{tikzpicture}
    \def\vsp@n{0}%
    \foreach \vsp@s in {#1} {\xdef\vsp@n{\the\numexpr\vsp@n+1\relax}}
    \pgfmathsetlengthmacro{\vsp@gap}{9pt}
    \pgfmathsetlengthmacro{\vsp@w}{(\linewidth-(\vsp@n-1)*\vsp@gap-0.6pt)/\vsp@n}
    \pgfmathsetlengthmacro{\vsp@h}{21pt}
    \foreach \vsp@s [count=\vsp@i] in {#1} {
      \pgfmathsetlengthmacro{\vsp@x}{(\vsp@i-1)*(\vsp@w+\vsp@gap)}
      \fill[SHTURed!5!white,rounded corners=1.4mm] (\vsp@x,0) rectangle (\vsp@x+\vsp@w,\vsp@h);
      \draw[SHTURed!22!white,line width=.5pt,rounded corners=1.4mm] (\vsp@x,0) rectangle (\vsp@x+\vsp@w,\vsp@h);
      \node[circle,fill=SHTURed,text=white,minimum size=11pt,inner sep=0pt,
        font=\sffamily\bfseries\fontsize{5.8}{6}\selectfont]
        at (\vsp@x+10pt,.5*\vsp@h) {\vsp@two{\vsp@i}};
      \node[anchor=west,text=VSPText,inner sep=0pt,
        font=\sffamily\bfseries\fontsize{6.9}{8}\selectfont]
        at (\vsp@x+19pt,.5*\vsp@h) {\vsp@s};
      \ifnum\vsp@i<\vsp@n
        \draw[SHTURed!45!white,line width=.6pt,line cap=round]
          (\vsp@x+\vsp@w+2.2pt,.5*\vsp@h) -- (\vsp@x+\vsp@w+\vsp@gap-2.2pt,.5*\vsp@h);
        \draw[SHTURed!45!white,line width=.6pt,line cap=round,line join=round]
          (\vsp@x+\vsp@w+\vsp@gap-4.2pt,.5*\vsp@h+2pt)
          -- (\vsp@x+\vsp@w+\vsp@gap-2.2pt,.5*\vsp@h)
          -- (\vsp@x+\vsp@w+\vsp@gap-4.2pt,.5*\vsp@h-2pt);
      \fi
    }
  \end{tikzpicture}\par}

% \VSPmeter[color]{fraction}{label}{value}: clean flat horizontal meter.
\newcommand{\VSPmeter}[4][SHTURed]{%
  \par\noindent
  \begin{tikzpicture}
    \pgfmathsetlengthmacro{\vsp@w}{\linewidth}
    \node[anchor=base west,inner sep=0pt,text=VSPText,font=\sffamily\fontsize{7}{8.4}\selectfont]
      at (0,6.5pt) {#3};
    \node[anchor=base east,inner sep=0pt,text=#1,font=\sffamily\bfseries\fontsize{7}{8.4}\selectfont]
      at (\vsp@w,6.5pt) {#4};
    \fill[VSPMuted!16!white,rounded corners=1.5pt] (0,0) rectangle (\vsp@w,3pt);
    \fill[#1,rounded corners=1.5pt] (0,0) rectangle ({max(3pt,#2*\vsp@w)},3pt);
  \end{tikzpicture}\par}

\mode<all>
